# Copy this file to ".env" and fill in your values.
# .env is git-ignored, so your secrets never reach the repository.

# Telegram bot credentials (from @BotFather and @userinfobot / getUpdates)
TELEGRAM_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# Joinnus event URL to watch
EVENT_URL=https://www.joinnus.com/events/concerts/lima-becky-armstrong-en-lima-unspoken-word-tour-2027-80565

# Seconds between checks (optional, default 120)
POLL_INTERVAL=120

# Run the browser headless (optional: true/false, default true)
HEADLESS=true
